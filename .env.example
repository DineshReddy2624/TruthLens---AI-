# TruthLens AI - Environment Configuration
# Copy this file to .env and fill in the values

# Database (for instant local running with seeded SQLite database):
DATABASE_URL=sqlite:///./truthlens.db

# MySQL (when running with Docker Compose):
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=truthlens
MYSQL_USER=truthlens
MYSQL_PASSWORD=changeme_in_production
MYSQL_ROOT_PASSWORD=rootpassword_change_this

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama LLM
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Search API (pluggable: tavily, serpapi, brave)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-api-key-here

# App
APP_ENV=development
APP_DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
